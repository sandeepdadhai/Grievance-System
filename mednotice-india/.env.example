# MedNotice India runtime configuration
# Copy to .env and export before starting the API (the demo runs without any of these).

# API port (default 4100). The Vite dev server proxies /api to this port.
PORT=4100

# Absolute or relative directory for the SQLite database, encrypted uploads,
# outbox emails and the generated development master key.
DATA_DIR=./data

# 32-byte AES-256 master key, base64 encoded. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When omitted, a 0600 file is generated at $DATA_DIR/.master.key (development only).
# MASTER_KEY=

# Set to production to enable Secure cookies and HSTS.
NODE_ENV=development

# Optional: override the project root (used for locating client/dist when serving
# the production build from a different working directory).
# PROJECT_ROOT=/srv/mednotice-india

# Front-end dev server (Vite) — see client/vite.config.ts
# Dev server: http://localhost:3001, API proxy target http://127.0.0.1:4100

# ---- public sharing (scripts/share.sh / npm run share) ----------------------
# Leave both unset to use an anonymous Cloudflare quick tunnel: free, no account,
# but the *.trycloudflare.com hostname changes whenever the tunnel restarts.
#
# Set both to serve the app on your own domain through a named Cloudflare tunnel
# (stable URL, survives restarts). The hostname itself is configured in the
# Cloudflare Zero Trust dashboard — see README "Custom domain".
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_URL=https://grievances.yourdomain.com
