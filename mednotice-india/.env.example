# MedNotice India runtime configuration
# Copy to .env and export before starting the API (the demo runs without any of these).

# API port (default 4100). The Vite dev server proxies /api to this port.
PORT=4100

# Absolute or relative directory for the SQLite database, encrypted uploads,
# outbox emails and the generated development master key.
DATA_DIR=./data

# 32-byte AES-256 master key, base64 encoded. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When omitted, a 0600 file is generated at $DATA_DIR/.master.key (development only).
# MASTER_KEY=

# Set to production to enable Secure cookies and HSTS.
NODE_ENV=development

# Optional: override the project root (used for locating client/dist when serving
# the production build from a different working directory).
# PROJECT_ROOT=/srv/mednotice-india

# Front-end dev server (Vite) — see client/vite.config.ts
# Dev server: http://localhost:3001, API proxy target http://127.0.0.1:4100

# ---- WhatsApp patient notifications (Meta WhatsApp Cloud API) ---------------
# Leave the token unset to run the channel in simulation: messages are written to
# $DATA_DIR/outbox/*.wa.json and marked SENT with provider OUTBOX. Set both values
# to deliver through a live WhatsApp Business number. See README "WhatsApp delivery".
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=mednotice_case_update
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY=91
# WHATSAPP_SIMULATE=0

# ---- SMS one-time passwords (patient mobile login + Aadhaar verification) ---
# Without credentials the channel runs in simulation: each code is written to
# $DATA_DIR/outbox/sms-*.txt and the API echoes it back as devCode so the flow
# stays demonstrable. Point SMS_API_URL at your aggregator's send endpoint
# (MSG91, Kaleyra, Gupshup, …) which receives {to, message, sender} as JSON with
# an Authorization: Bearer <SMS_API_KEY> header, or set SMS_PROVIDER=twilio.
# SMS_PROVIDER=generic
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=MEDNOT
# SMS_TWILIO_SID=
# SMS_TWILIO_TOKEN=
# SMS_TWILIO_FROM=
# SMS_SIMULATE=0
# SMS_DEFAULT_COUNTRY=91
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# ---- Aadhaar gate ----------------------------------------------------------
# Set to 0 to let patient accounts file a grievance without a verified Aadhaar.
# AADHAAR_REQUIRED=1

# Public origin used in WhatsApp message links (also used by scripts/share.sh).
# PUBLIC_URL=https://grievances.yourdomain.com

# ---- public sharing (scripts/share.sh / npm run share) ----------------------
# Leave both unset to use an anonymous Cloudflare quick tunnel: free, no account,
# but the *.trycloudflare.com hostname changes whenever the tunnel restarts.
#
# Set both to serve the app on your own domain through a named Cloudflare tunnel
# (stable URL, survives restarts). The hostname itself is configured in the
# Cloudflare Zero Trust dashboard — see README "Custom domain".
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_URL=https://grievances.yourdomain.com
