{
  "name": "mednotice-india",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MedNotice India — India-only patient grievance intake, document verification and health-authority routing",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:web:admin\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "dev:web:admin": "vite --config client/vite.admin.config.ts",
    "build": "npm run build:patient && npm run build:admin && tsc -p tsconfig.server.json",
    "build:patient": "vite build --config client/vite.config.ts",
    "build:admin": "vite build --config client/vite.admin.config.ts",
    "start": "node dist/server/index.js",
    "start:admin": "node dist/server/admin.js",
    "share": "bash scripts/share.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx server/seed-cli.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
